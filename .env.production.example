# Salin sebagai .env.production di VPS, lalu isi nilai rahasia.
PG_USER=lapakwu
PG_PASSWORD=GANTI_DENGAN_HEX_ACAK_64_KARAKTER
PG_DATABASE=lapakwu
LAPAKWU_PORT=3101
NEXT_PUBLIC_APP_URL=https://lapakwu.bluepack.my.id
NEXT_PUBLIC_QRIS_URL=/qris.jpg
NEXT_PUBLIC_KONTAK_EMAIL=

# Buat nilai acak dengan: openssl rand -base64 48
JWT_SECRET=

# File rahasia terpisah yang dimuat Docker Compose: .env.production.secrets.
KOMISI_PERSEN=5
