# Salin jadi .env.local lalu isi
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Hanya dipakai server (script setup + route /api). JANGAN pakai prefix NEXT_PUBLIC_
APPWRITE_API_KEY=
# Persen komisi platform dari tiap pesanan selesai
KOMISI_PERSEN=5

# Email gratis lewat Brevo (300 email/hari): brevo.com > SMTP & API > API keys
BREVO_API_KEY=
# Email pengirim yang sudah divalidasi di Brevo (Senders)
EMAIL_PENGIRIM=

# WhatsApp gratis lewat Fonnte (free plan 1.000 pesan/bulan): fonnte.com > device > token
FONNTE_TOKEN=

# Opsional: kontak yang tampil di footer (nomor format 62812xxxx)
NEXT_PUBLIC_KONTAK_WA=
NEXT_PUBLIC_KONTAK_EMAIL=
