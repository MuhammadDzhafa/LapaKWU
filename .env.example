# Salin konfigurasi yang diperlukan ke .env.local.
MONGODB_URI=
MONGODB_DB=lapakwu

# Backblaze B2 storage, used for product photos, QRIS images, and payment proofs.
Backblaze_keyID=
Backblaze_app_key=
Backblaze_bucketName=
# Hanya dipakai saat migrasi dari MySQL.
MYSQL_SOURCE_URL=

# Isi dengan secret acak minimal 32 karakter. Pertahankan secret lama saat migrasi.
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QRIS_URL=/qris.jpg
KOMISI_PERSEN=5

# Interpreter Python dari virtual environment PaddleOCR dan nama merchant pada bukti QRIS.
OCR_PYTHON=
OCR_NAMA_PENERIMA=
PADDLE_PDX_CACHE_HOME=
# Gunakan "local" untuk menyimpan unggahan di komputer saat npm run dev.
LAPAKWU_STORAGE=

# SMTP Gmail dan WhatsApp opsional.
EMAIL_USER=
EMAIL_PASS=
FONNTE_TOKEN=
NEXT_PUBLIC_KONTAK_WA=
NEXT_PUBLIC_KONTAK_EMAIL=

# Opsional, hanya untuk konfirmasi dana lewat webhook yang sudah dipercaya.
PAYHOOK_SECRET=
