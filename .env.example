# PostgreSQL (wajib). Gunakan password acak yang kuat pada lingkungan produksi.
POSTGRES_URL=postgresql://lapakwu:CHANGE_ME@127.0.0.1:5432/lapakwu
PG_POOL_MAX=10

# Rahasia sesi JWT (wajib di production, minimal 32 karakter acak).
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QRIS_URL=/qris.jpg
KOMISI_PERSEN=5

# Backblaze B2 (wajib untuk unggah/unduh foto produk dan bukti pembayaran).
Backblaze_keyID=
Backblaze_app_key=
Backblaze_bucketName=

# PaddleOCR berjalan lokal di server aplikasi.
OCR_PYTHON=
OCR_NAMA_PENERIMA=
PADDLE_PDX_CACHE_HOME=
# Gunakan "local" untuk menyimpan unggahan di komputer saat npm run dev.
LAPAKWU_STORAGE=
# Saat npm run dev: tampilkan OTP, tautan reset, dan notifikasi di terminal.
LAPAKWU_NOTIFIKASI=

# Email dan WhatsApp opsional; diperlukan untuk fitur notifikasi terkait.
EMAIL_USER=
EMAIL_PASS=
FONNTE_TOKEN=
NEXT_PUBLIC_KONTAK_WA=6281297490280
NEXT_PUBLIC_KONTAK_EMAIL=

# Opsional untuk webhook notifikasi pembayaran.
PAYHOOK_SECRET=
PAYHOOK_TOKEN=

# Hanya dipakai saat membuat akun admin awal.
INITIAL_ADMIN_PASSWORD=
